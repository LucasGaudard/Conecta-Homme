generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  PORTER
  RESIDENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum UnitStatus {
  ACTIVE
  INACTIVE
}

enum PresenceStatus {
  HOME
  AWAY
  DO_NOT_DISTURB
}

enum VisitorStatus {
  AUTHORIZED
  EXPIRED
  USED
  CANCELED
}

enum AccessType {
  ENTRY
  EXIT
}

enum AccessMethod {
  MANUAL
  QR_CODE
}

enum PackageStatus {
  WAITING_PICKUP
  DELIVERED
}

enum QRCodeType {
  RESIDENT
  VISITOR
}

enum QRCodeStatus {
  ACTIVE
  EXPIRED
  CANCELED
}

enum NotificationType {
  PACKAGE
  VISITOR
  ACCESS
  SYSTEM
}

enum NotificationStatus {
  UNREAD
  READ
}

enum LeisureSpaceStatus {
  ACTIVE
  INACTIVE
}

enum SpaceReservationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELED
}

enum CondominiumStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model Condominium {
  id           String            @id @default(cuid())
  name         String
  slug         String            @unique
  document     String?
  phone        String?
  email        String?
  address      String?
  porterHours  String?
  logoUrl      String?
  status       CondominiumStatus @default(ACTIVE)
  planCode     String?
  billingEmail String?
  trialEndsAt  DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  units               Unit[]
  users               User[]
  visitors            Visitor[]
  visitAuthorizations VisitAuthorization[]
  accessLogs          AccessLog[]
  qrCodeTokens        QRCodeToken[]
  packages            Package[]
  notifications       Notification[]
  auditLogs           AuditLog[]
  leisureSpaces       LeisureSpace[]
  spaceReservations   SpaceReservation[]
}

model User {
  id                     String     @id @default(cuid())
  name                   String
  email                  String     @unique
  username               String?    @unique
  passwordHash           String
  role                   UserRole
  status                 UserStatus @default(ACTIVE)
  phone                  String?
  porterShiftDescription String?
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt
  unitId                 String?
  condominiumId          String?

  condominium           Condominium?         @relation(fields: [condominiumId], references: [id])
  unit                  Unit?                @relation(fields: [unitId], references: [id])
  authorizedVisits      VisitAuthorization[] @relation("UserAuthorizedVisits")
  accessLogs            AccessLog[]          @relation("AccessLogUser")
  porterAccessLogs      AccessLog[]          @relation("AccessLogPorter")
  receivedPackages      Package[]            @relation("PackageReceivedBy")
  deliveredPackages     Package[]            @relation("PackageDeliveredBy")
  notifications         Notification[]
  auditLogs             AuditLog[]
  requestedReservations SpaceReservation[]   @relation("ReservationRequestedBy")
  approvedReservations  SpaceReservation[]   @relation("ReservationApprovedBy")
  passwordResetTokens   PasswordResetToken[]

  @@index([condominiumId])
  @@index([unitId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([usedAt])
}

model Unit {
  id              String         @id @default(cuid())
  condominiumId   String
  block           String
  apartment       String
  responsibleName String
  cpf             String?
  phone           String?
  email           String?
  status          UnitStatus     @default(ACTIVE)
  presenceStatus  PresenceStatus @default(HOME)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  condominium         Condominium          @relation(fields: [condominiumId], references: [id])
  users               User[]
  visitAuthorizations VisitAuthorization[]
  accessLogs          AccessLog[]
  packages            Package[]
  notifications       Notification[]
  qrCodeTokens        QRCodeToken[]
  spaceReservations   SpaceReservation[]

  @@unique([condominiumId, block, apartment])
  @@index([condominiumId])
}

model Visitor {
  id            String   @id @default(cuid())
  condominiumId String
  name          String
  document      String?
  phone         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  condominium         Condominium          @relation(fields: [condominiumId], references: [id])
  visitAuthorizations VisitAuthorization[]
  accessLogs          AccessLog[]
  qrCodeTokens        QRCodeToken[]

  @@index([condominiumId])
}

model VisitAuthorization {
  id             String        @id @default(cuid())
  condominiumId  String
  visitorId      String
  unitId         String
  authorizedById String
  startsAt       DateTime
  endsAt         DateTime
  status         VisitorStatus @default(AUTHORIZED)
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  condominium  Condominium   @relation(fields: [condominiumId], references: [id])
  visitor      Visitor       @relation(fields: [visitorId], references: [id])
  unit         Unit          @relation(fields: [unitId], references: [id])
  authorizedBy User          @relation("UserAuthorizedVisits", fields: [authorizedById], references: [id])
  qrCodeTokens QRCodeToken[]

  @@index([condominiumId])
  @@index([visitorId])
  @@index([unitId])
  @@index([authorizedById])
}

model AccessLog {
  id            String       @id @default(cuid())
  condominiumId String
  unitId        String?
  visitorId     String?
  userId        String?
  porterId      String?
  accessType    AccessType
  accessMethod  AccessMethod @default(MANUAL)
  occurredAt    DateTime     @default(now())
  notes         String?
  createdAt     DateTime     @default(now())

  condominium Condominium @relation(fields: [condominiumId], references: [id])
  unit        Unit?       @relation(fields: [unitId], references: [id])
  visitor     Visitor?    @relation(fields: [visitorId], references: [id])
  user        User?       @relation("AccessLogUser", fields: [userId], references: [id])
  porter      User?       @relation("AccessLogPorter", fields: [porterId], references: [id])

  @@index([condominiumId])
  @@index([unitId])
  @@index([visitorId])
  @@index([userId])
  @@index([porterId])
  @@index([occurredAt])
}

model Package {
  id             String        @id @default(cuid())
  condominiumId  String
  unitId         String
  carrier        String?
  trackingCode   String?
  pickupCode     String?
  photoUrl       String?
  description    String?
  status         PackageStatus @default(WAITING_PICKUP)
  receivedById   String?
  deliveredById  String?
  pickedUpByName String?
  receivedAt     DateTime      @default(now())
  deliveredAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  condominium Condominium @relation(fields: [condominiumId], references: [id])
  unit        Unit        @relation(fields: [unitId], references: [id])
  receivedBy  User?       @relation("PackageReceivedBy", fields: [receivedById], references: [id])
  deliveredBy User?       @relation("PackageDeliveredBy", fields: [deliveredById], references: [id])

  @@index([condominiumId])
  @@index([unitId])
  @@index([receivedById])
  @@index([deliveredById])
}

model Notification {
  id            String             @id @default(cuid())
  condominiumId String?
  userId        String?
  unitId        String?
  title         String
  message       String
  type          NotificationType
  status        NotificationStatus @default(UNREAD)
  createdAt     DateTime           @default(now())
  readAt        DateTime?

  condominium Condominium? @relation(fields: [condominiumId], references: [id])
  user        User?        @relation(fields: [userId], references: [id])
  unit        Unit?        @relation(fields: [unitId], references: [id])

  @@index([condominiumId])
  @@index([userId])
  @@index([unitId])
}

model CondominiumSettings {
  id          String   @id @default(cuid())
  name        String
  phone       String?
  email       String?
  address     String?
  porterHours String?
  logoUrl     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model LeisureSpace {
  id            String             @id @default(cuid())
  condominiumId String
  name          String
  description   String?
  location      String?
  capacity      Int?
  rules         String?
  status        LeisureSpaceStatus @default(ACTIVE)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  condominium  Condominium        @relation(fields: [condominiumId], references: [id])
  reservations SpaceReservation[]

  @@index([condominiumId])
  @@index([status])
  @@index([name])
}

model SpaceReservation {
  id              String                 @id @default(cuid())
  condominiumId   String
  spaceId         String
  unitId          String
  requestedById   String
  startAt         DateTime
  endAt           DateTime
  status          SpaceReservationStatus @default(PENDING)
  notes           String?
  rejectionReason String?
  approvedById    String?
  approvedAt      DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  condominium Condominium  @relation(fields: [condominiumId], references: [id])
  space       LeisureSpace @relation(fields: [spaceId], references: [id])
  unit        Unit         @relation(fields: [unitId], references: [id])
  requestedBy User         @relation("ReservationRequestedBy", fields: [requestedById], references: [id])
  approvedBy  User?        @relation("ReservationApprovedBy", fields: [approvedById], references: [id])

  @@index([condominiumId])
  @@index([spaceId])
  @@index([unitId])
  @@index([requestedById])
  @@index([approvedById])
  @@index([status])
  @@index([startAt])
  @@index([endAt])
}

model AuditLog {
  id            String   @id @default(cuid())
  condominiumId String?
  userId        String?
  userName      String?
  userEmail     String?
  userRole      UserRole
  action        String
  module        String
  description   String
  entityType    String?
  entityId      String?
  createdAt     DateTime @default(now())

  condominium Condominium? @relation(fields: [condominiumId], references: [id])
  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([condominiumId])
  @@index([userId])
  @@index([userRole])
  @@index([action])
  @@index([module])
  @@index([createdAt])
  @@index([entityType, entityId])
}

model QRCodeToken {
  id                   String       @id @default(cuid())
  condominiumId        String
  token                String       @unique
  accessCode           String       @unique
  type                 QRCodeType
  status               QRCodeStatus @default(ACTIVE)
  unitId               String?
  visitorId            String?
  visitAuthorizationId String?
  expiresAt            DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  condominium        Condominium         @relation(fields: [condominiumId], references: [id])
  unit               Unit?               @relation(fields: [unitId], references: [id])
  visitor            Visitor?            @relation(fields: [visitorId], references: [id])
  visitAuthorization VisitAuthorization? @relation(fields: [visitAuthorizationId], references: [id])

  @@index([condominiumId])
  @@index([unitId])
  @@index([visitorId])
  @@index([visitAuthorizationId])
  @@index([accessCode])
}
